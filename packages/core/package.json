{
  "name": "@wave/core",
  "version": "0.0.0",
  "private": true,
  "description": "Wave's domain logic. Pure TypeScript with zero runtime dependencies, so its tests run anywhere with plain Node.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "test": "node --test",
    "bench:import": "node bench/playlistImport.ts",
    "bench:queries": "node bench/libraryQueries.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:"
  }
}
