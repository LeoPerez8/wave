{
  "name": "wave",
  "private": true,
  "description": "Local music player for Android with Apple Music's look and feel.",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @wave/mobile start",
    "android": "pnpm --filter @wave/mobile android",
    "typecheck": "pnpm -r typecheck && tsc -p scripts/ci && tsc -p scripts/perf",
    "test": "pnpm -r test && node --test \"scripts/ci/*.test.ts\" \"scripts/perf/*.test.ts\"",
    "perf": "node scripts/perf/perf.ts",
    "test:core": "pnpm --filter @wave/core test",
    "lint": "oxlint",
    "fmt": "prettier --write .",
    "fmt:check": "prettier --check .",
    "react-doctor": "node scripts/ci/react-doctor.mjs full",
    "react-doctor:check": "node scripts/ci/react-doctor.mjs baseline",
    "fallow": "fallow --only dead-code,dupes",
    "fallow:dead-code": "fallow dead-code",
    "fallow:dupes": "fallow dupes",
    "fallow:check": "fallow audit --gate new-only",
    "test:react-doctor": "node --test scripts/ci/react-doctor-report.test.mjs"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "fallow": "3.33.1",
    "oxlint": "^1.0.0",
    "prettier": "3.9.10",
    "react-doctor": "0.9.18",
    "typescript": "catalog:"
  },
  "engines": {
    "node": ">=22.18"
  },
  "packageManager": "pnpm@10.28.0"
}
