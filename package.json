{
  "name": "wave",
  "private": true,
  "description": "Local music player for Android with Apple Music's look and feel.",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @wave/mobile start",
    "android": "pnpm --filter @wave/mobile android",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:core": "pnpm --filter @wave/core test",
    "lint": "oxlint",
    "fmt": "prettier --write .",
    "fmt:check": "prettier --check .",
    "react-doctor": "react-doctor apps/mobile --yes --scope full --blocking none --json --json-out .cache/react-doctor/full.json && node scripts/ci/react-doctor-report.mjs .cache/react-doctor/full.json",
    "react-doctor:check": "react-doctor apps/mobile --yes --scope changed --blocking error --include-untracked --verbose",
    "fallow": "fallow --only dead-code,dupes",
    "fallow:dead-code": "fallow dead-code",
    "fallow:dupes": "fallow dupes",
    "fallow:check": "fallow audit --gate new-only"
  },
  "devDependencies": {
    "fallow": "3.33.1",
    "oxlint": "^1.0.0",
    "prettier": "3.9.10",
    "react-doctor": "0.9.18"
  },
  "engines": {
    "node": ">=22.18"
  },
  "packageManager": "pnpm@10.28.0"
}
