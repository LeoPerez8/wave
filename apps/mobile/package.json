{
  "name": "@wave/mobile",
  "version": "0.27.1-ti",
  "private": true,
  "main": "./index.ts",
  "scripts": {
    "start": "expo start",
    "android": "EXPO_NO_GIT_STATUS=1 expo prebuild --clean --platform android && expo run:android",
    "prebuild": "EXPO_NO_GIT_STATUS=1 expo prebuild --clean --platform android",
    "typecheck": "tsc --noEmit",
    "icons": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/render-icons.ts",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test 'src/**/*.test.ts' 'plugins/**/*.test.ts'",
    "bench:artist-stats": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON bench/artistStats.ts",
    "bench:home-totals": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON bench/homeTotals.ts",
    "bench:playlist-fill": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON bench/playlistFill.ts",
    "bench:queue-covers": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON bench/queueCovers.ts",
    "bench:scan-batch": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON bench/scanBatch.ts",
    "bench:songs-list": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON bench/songsList.ts",
    "bench:fast-again": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON bench/fastAgain.ts",
    "measure:splash": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/measure-launch-splash.ts"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@legendapp/list": "3.3.5",
    "@shopify/react-native-skia": "2.13.1",
    "@tabler/icons-react-native": "^3.44.0",
    "@wave/core": "workspace:*",
    "drizzle-orm": "0.45.4",
    "effect": "4.0.2",
    "expo": "~58.0.2",
    "expo-build-properties": "~58.0.10",
    "expo-constants": "~58.0.10",
    "expo-font": "~58.0.7",
    "expo-haptics": "~58.0.5",
    "expo-image": "~58.0.10",
    "expo-linking": "~58.0.11",
    "expo-router": "~58.0.17",
    "expo-splash-screen": "~58.0.7",
    "expo-sqlite": "~58.0.11",
    "expo-status-bar": "~58.0.3",
    "expo-system-ui": "~58.0.5",
    "react": "19.3.0",
    "react-native": "0.88.0-rc.4",
    "react-native-gesture-handler": "~3.2.1",
    "react-native-reanimated": "4.7.0",
    "react-native-safe-area-context": "~5.9.1",
    "react-native-screens": "~4.28.0",
    "react-native-svg": "15.15.5",
    "react-native-worklets": "0.13.0",
    "tailwindcss": "^4.3.3",
    "uniwind": "1.12.1"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/react": "~19.3.0",
    "@types/sql.js": "^1.4.11",
    "sql.js": "^1.14.2",
    "typescript": "catalog:"
  },
  "expo": {
    "install": {
      "exclude": [
        "typescript"
      ]
    }
  }
}
