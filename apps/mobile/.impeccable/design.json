      "css": ".ds-ibwrap{background:#e0ecef;padding:12px;display:flex;gap:8px;} .ds-ib{width:48px;height:48px;display:flex;align-items:center;justify-content:center;background:none;border:0;border-radius:0;color:#006a5f;cursor:pointer;transition:opacity 140ms cubic-bezier(0.16,1,0.3,1),transform 140ms cubic-bezier(0.16,1,0.3,1);} .ds-ib:disabled{color:#778385;cursor:default;} .ds-ib:not(:disabled):active{opacity:.65;transform:scale(.9);} .ds-ib:focus-visible{outline:2px solid #006a5f;}"
