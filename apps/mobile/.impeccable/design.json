    {
      "name": "Entry Row",
      "kind": "nav",
      "refersTo": "entry-row",
      "description": "A Library entry: one quiet line, a reserved count column, a hairline. No icon, no chevron.",
      "html": "<div class=\"ds-entries\"><button class=\"ds-entry\"><span class=\"ds-entry-label\">Albums</span><span class=\"ds-entry-count\">1,284</span></button><button class=\"ds-entry\"><span class=\"ds-entry-label\">Songs</span><span class=\"ds-entry-count\">14,902</span></button></div>",
      "css": ".ds-entries{background:#e0ecef;padding:0 24px;border-top:1px solid #c1cdd0;} .ds-entry{font-family:Inter,system-ui,sans-serif;display:flex;align-items:center;width:100%;height:56px;padding:0;background:none;border:0;border-bottom:1px solid #c1cdd0;color:#121b1d;cursor:pointer;transition:opacity 140ms cubic-bezier(0.16,1,0.3,1),transform 140ms cubic-bezier(0.16,1,0.3,1);} .ds-entry-label{flex:1;text-align:left;font-size:20px;line-height:26px;font-weight:400;} .ds-entry-count{font-size:15px;line-height:20px;color:#454f52;font-variant-numeric:tabular-nums;} .ds-entry:active{opacity:.65;transform:scale(.96);} .ds-entry:focus-visible{outline:2px solid #006a5f;outline-offset:-2px;}"
    },
