      "css": ".ds-tracks{background:#e0ecef;padding:0 24px;} .ds-track{font-family:Inter,system-ui,sans-serif;display:flex;align-items:center;gap:12px;width:100%;height:56px;padding:0;background:none;border:0;cursor:pointer;color:#121b1d;transition:opacity 140ms cubic-bezier(0.16,1,0.3,1),transform 140ms cubic-bezier(0.16,1,0.3,1);} .ds-thumb{width:40px;height:40px;flex:none;} .ds-track-text{flex:1;display:flex;flex-direction:column;text-align:left;min-width:0;} .ds-track-title{font-size:16px;line-height:22px;font-weight:500;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;} .ds-track-artist{font-size:16px;line-height:22px;color:#454f52;} .ds-cell{width:24px;display:flex;justify-content:center;color:#a14f09;} .ds-cell svg{width:18px;height:18px;} .ds-star{font-size:14px;} .ds-dur{width:40px;text-align:right;font-size:13px;line-height:18px;color:#454f52;font-variant-numeric:tabular-nums;} .ds-track-playing .ds-track-title{color:#a14f09;} .ds-track:active{opacity:.65;transform:scale(.985);} .ds-track:focus-visible{outline:2px solid #006a5f;}"
