<manifest xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:tools="http://schemas.android.com/tools">
  <!-- Wave is sideloaded, not on the Play Store, so all-files access is acceptable (see docs/spec.md). -->
  <uses-permission
    android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
    tools:ignore="ScopedStorage" />

  <!-- Artist photos and YT Music are online (docs/spec.md, "Network"). -->
  <uses-permission android:name="android.permission.INTERNET" />
  <!-- YT Music doesn't try a request without a network, and says it's offline instead. -->
  <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

  <!-- Background playback with a media notification. -->
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
  <uses-permission android:name="android.permission.WAKE_LOCK" />

  <!-- YT Music downloads and the whole-Library lyrics and genre run use data-sync foreground services, with progress notifications. -->
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

  <!-- Recognize listens through the microphone, asked for on first use (docs/spec.md, "Recognize"). -->
  <uses-permission android:name="android.permission.RECORD_AUDIO" />

  <!-- The Wi-Fi pre-download's job is kept across reboots (PreDownloads, JobInfo.setPersisted). -->
  <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

  <!--
    The lyrics card's Instagram Stories and WhatsApp destinations show only when the app is
    installed (ShareModule's shareApps); Android 11+ hides other packages unless they're queried.
  -->
  <queries>
    <package android:name="com.instagram.android" />
    <package android:name="com.whatsapp" />
  </queries>

  <application>
    <!-- A media library service: Android Auto browses Wave through it (docs/auto-spike.md). -->
    <service
      android:name="expo.modules.wavenative.player.PlaybackService"
      android:exported="true"
      android:foregroundServiceType="mediaPlayback">
      <intent-filter>
        <action android:name="androidx.media3.session.MediaLibraryService" />
        <action android:name="android.media.browse.MediaBrowserService" />
      </intent-filter>
    </service>

    <!-- Keeps YT Music downloads going with Wave in the background (YtDownloadService). -->
    <service
      android:name="expo.modules.wavenative.yt.YtDownloadService"
      android:exported="false"
      android:foregroundServiceType="dataSync" />

    <!-- Fetches the start of the day's mixes into the audio cache on Wi-Fi, silently (PreDownloads). -->
    <service
      android:name="expo.modules.wavenative.yt.PreDownloadJob"
      android:permission="android.permission.BIND_JOB_SERVICE"
      android:exported="false" />

    <!-- Keeps Settings' whole-Library lyrics and genre run going in the background (LibraryLookupService). -->
    <service
      android:name="expo.modules.wavenative.lookup.LibraryLookupService"
      android:exported="false"
      android:foregroundServiceType="dataSync" />

    <!--
      Media buttons with nothing playing resume the last queue (playback resumption,
      PlaybackService.onPlaybackResumption); Media3 requires it to be declared.
    -->
    <receiver
      android:name="androidx.media3.session.MediaButtonReceiver"
      android:exported="true">
      <intent-filter>
        <action android:name="android.intent.action.MEDIA_BUTTON" />
      </intent-filter>
    </receiver>

    <!--
      Settings › YT Music › Sign In: Google's sign-in page in a web view (YtSignInActivity).
      It handles rotation and theme changes itself, so a half-typed sign-in isn't reloaded.
    -->
    <activity
      android:name="expo.modules.wavenative.yt.YtSignInActivity"
      android:exported="false"
      android:theme="@android:style/Theme.DeviceDefault.DayNight"
      android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|density|keyboard|keyboardHidden|navigation|uiMode|fontScale"
      android:windowSoftInputMode="adjustResize" />

    <!-- Settings › Accounts › Spotify › Sign In: Spotify's sign-in page in a web view (SpotifySignInActivity). -->
    <activity
      android:name="expo.modules.wavenative.spotify.SpotifySignInActivity"
      android:exported="false"
      android:theme="@android:style/Theme.DeviceDefault.DayNight"
      android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|density|keyboard|keyboardHidden|navigation|uiMode|fontScale"
      android:windowSoftInputMode="adjustResize" />

    <!-- Cached artwork as content URIs: Android Auto can't read Wave's files (ArtworkProvider). -->
    <provider
      android:name="expo.modules.wavenative.artwork.ArtworkProvider"
      android:authorities="${applicationId}.artwork"
      android:exported="true" />

    <!-- Settings › Developer › Export Logs shares the app log as a file (AppLogFileProvider). -->
    <provider
      android:name="expo.modules.wavenative.log.AppLogFileProvider"
      android:authorities="${applicationId}.logs"
      android:exported="false"
      android:grantUriPermissions="true">
      <meta-data
        android:name="android.support.FILE_PROVIDER_PATHS"
        android:resource="@xml/wave_log_paths" />
    </provider>

    <!-- The lyrics card goes to the share sheet as an image (ShareImageProvider). -->
    <provider
      android:name="expo.modules.wavenative.share.ShareImageProvider"
      android:authorities="${applicationId}.images"
      android:exported="false"
      android:grantUriPermissions="true">
      <meta-data
        android:name="android.support.FILE_PROVIDER_PATHS"
        android:resource="@xml/wave_share_paths" />
    </provider>

    <!-- Lists Wave as a media app in Android Auto. -->
    <meta-data
      android:name="com.google.android.gms.car.application"
      android:resource="@xml/automotive_app_desc" />
  </application>
</manifest>
