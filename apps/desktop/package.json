{
  "name": "@wave/desktop",
  "productName": "Wave",
  "version": "0.0.0",
  "private": true,
  "description": "Wave for Windows and Linux: an Electron app over @wave/client.",
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "build:native": "node scripts/build-native.ts",
    "build:jvm": "node scripts/build-jvm.ts",
    "start": "electron-vite preview",
    "test": "node --test \"src/**/*.test.ts\"",
    "test:e2e": "electron-vite build && playwright test",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.web.json",
    "lint": "oxlint --quiet ."
  },
  "dependencies": {
    "@wave/client": "workspace:*",
    "@wave/core": "workspace:*",
    "better-sqlite3": "13.2.0",
    "drizzle-orm": "0.45.4",
    "effect": "4.0.2",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@tailwindcss/vite": "4.3.5",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "catalog:",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "electron": "45.3.4",
    "electron-vite": "6.0.0",
    "oxlint": "^1.0.0",
    "tailwindcss": "4.3.5",
    "typescript": "catalog:",
    "vite": "8.3.8"
  }
}
