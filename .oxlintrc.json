{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "react", "unicorn", "oxc", "import"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "rules": {
    "react/react-in-jsx-scope": "off",
    "no-restricted-imports": [
      "error",
      {
        "paths": [
          {
            "name": "react-native",
            "importNames": ["BackHandler"],
            "message": "Use addScreenBackHandler (src/overlay/back.ts) so open cards take Back first."
          }
        ]
      }
    ]
  },
  "ignorePatterns": [
    "**/node_modules/**",
    "**/android/**",
    "**/ios/**",
    "**/.expo/**",
    "apps/mobile/uniwind-types.d.ts"
  ],
  "overrides": [
    {
      "files": ["apps/mobile/src/overlay/**"],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ]
}
